# SigNoz ClickHouse Configuration
# Managed separately from SigNoz chart to allow independent version upgrades
# Update the image.tag to upgrade ClickHouse version

clickhouseInstallation:
  name: signoz-clickhouse
  namespace: signoz

  spec:
    configuration:
      clusters:
        - name: default
          layout:
            shardsCount: 1
            replicasCount: 2
          templates:
            podTemplates:
              - name: default
                spec:
                  containers:
                    - name: clickhouse
                      image: clickhouse/clickhouse-server:25.5.6
                      imagePullPolicy: IfNotPresent
                      resources:
                        requests:
                          memory: "2Gi"
                          cpu: "500m"
                        limits:
                          memory: "4Gi"
                          cpu: "2000m"
            serviceTemplates:
              - name: default
                spec:
                  type: ClusterIP
            volumeClaimTemplates:
              - name: default-log-pvc
                spec:
                  storageClassName: notify
                  accessModes:
                    - ReadWriteOnce
                  resources:
                    requests:
                      storage: 1Ti
              - name: default-data-pvc
                spec:
                  storageClassName: notify
                  accessModes:
                    - ReadWriteOnce
                  resources:
                    requests:
                      storage: 1Ti

      settings:
        # MergeTree settings
        merge_tree/max_suspicious_broken_parts: "200"
        # Replicas diverge from ZooKeeper during rolling restarts; let them re-attach
        # and re-sync from the healthy peer instead of staying readonly.
        merge_tree/replicated_max_ratio_of_wrong_parts: "1"

    zookeeper:
      nodes:
        - host: signoz-zookeeper-0.signoz-zookeeper-headless.signoz.svc.cluster.local
          port: 2181
        - host: signoz-zookeeper-1.signoz-zookeeper-headless.signoz.svc.cluster.local
          port: 2181
        - host: signoz-zookeeper-2.signoz-zookeeper-headless.signoz.svc.cluster.local
          port: 2181

# ZooKeeper configuration (required for ClickHouse replication)
zookeeper:
  replicaCount: 3
  persistence:
    enabled: true
    storageClass: notify
    size: 10Gi
  resources:
    requests:
      memory: "512Mi"
      cpu: "250m"
    limits:
      memory: "1Gi"
      cpu: "500m"
  nodeSelector:
    workload-type: signoz
  tolerations:
    - key: dedicated
      operator: Equal
      value: signoz
      effect: NoSchedule
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchExpressions:
                - key: app
                  operator: In
                  values:
                    - zookeeper
            topologyKey: kubernetes.io/hostname
